# =============================================================================
# MolarMetric — Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or real secrets to version control.
# =============================================================================

# --- Supabase ---
# Public anon key (safe for client-side, protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (server-side ONLY — NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MolarMetric

# --- Cashfree Payments (optional — billing disabled if absent) ---
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_API_VERSION=2023-08-01

# --- Error Monitoring (optional) ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

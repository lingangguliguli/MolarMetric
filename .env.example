# =============================================================================
# Dental Revenue Recovery OS — Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or real secrets to version control.
# =============================================================================

# --- Supabase ---
# Public anon key (safe for client-side, protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (server-side ONLY — NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Molarmetric

# --- Razorpay (optional — billing features disabled when absent) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Error Monitoring (optional — e.g. Sentry) ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- WhatsApp Business API (optional — click-to-chat works without this) ---
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
